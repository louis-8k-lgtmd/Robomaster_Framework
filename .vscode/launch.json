    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (DAP)",
            "type": "cortex-debug",
            "serverpath": "D:/Projects/OpenOCD/bin/openocd.exe",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/board/board.elf",
            "preLaunchTask": "Build Debug firmware",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg" //TODO:改为实际的芯片类型
                //"target/stm32h7x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGHx",//TODO:改为实际的芯片类型
            //"device": "STM32H723VGTx",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            // "svdFile": "${workspaceFolder}/STM32H7.svd"
        },


    ]
}
